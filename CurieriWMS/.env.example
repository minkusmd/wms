APP_NAME=CurieriWMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Firebird WMS: sursa operationala (tabelele WMS, fara Eloquent) ---
# In dezvoltare: containerul firebird-test (cale completa). Pe server: aliasul SW
# din databases.conf, gazda = IP-ul Windows Server (niciodata localhost).
FB_HOST=firebird-test
FB_PORT=3050
FB_DATABASE=/var/lib/firebird/data/curieri_test.fdb
FB_USERNAME=CURIERI
FB_PASSWORD=
FB_ROLE=
# secunde; un UPDATE blocat de alta tranzactie (ex. un dialog WMS deschis) cade dupa acest timp
FB_STATEMENT_TIMEOUT=10
# true DOAR pe baza de test: permite verificarile care scriu (mereu cu ROLLBACK)
FB_ALLOW_WRITE_PROBES=true

# --- docker compose: baza Firebird de test ---
FB_TEST_SYSDBA_PASSWORD=
FB_TEST_USER=CURIERI
FB_TEST_PASSWORD=
FB_TEST_PORT=3051
WEB_PORT=8080