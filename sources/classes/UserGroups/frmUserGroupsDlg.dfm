  object IBCDataSourceGroups: TIBCDataSource
    DataSet = IBCQueryGroups
    Left = 68
    Top = 152
  end
  object IBCQueryGroups: TIBCQuery
    KeyFields = 'GROUPID'
    KeyGenerator = 'SQ_TS_USER_GROUPS_GROUPID'
    GeneratorMode = gmInsert
    SQLInsert.Strings = (
      'INSERT INTO VW_TS_USER_GROUPS'
      
        '  (GROUPID, NAME, STRUCTURE_MASK, FLG_SERVICE, FLG_SERVICE_ENGIN' +
        'ER)'
      'VALUES'
      
        '  (:GROUPID, :NAME, :STRUCTURE_MASK, :FLG_SERVICE, :FLG_SERVICE_' +
        'ENGINER)')
    SQLDelete.Strings = (
      'DELETE FROM TS_USER_GROUPS'
      'WHERE'
      '  GROUPID = :Old_GROUPID')
    SQLUpdate.Strings = (
      'UPDATE VW_TS_USER_GROUPS'
      'SET'
      ' GROUPID = :GROUPID, '
      ' NAME = :NAME, '
      ' STRUCTURE_MASK = :STRUCTURE_MASK,'
      ' FLG_SERVICE = :FLG_SERVICE,'
      ' FLG_SERVICE_ENGINER = :FLG_SERVICE_ENGINER'
      'WHERE'
      '  GROUPID = :Old_GROUPID')
    SQLRefresh.Strings = (
      'SELECT '
      ' GROUPID, '
      ' NAME,'
      ' STRUCTURE_MASK,'
      ' FLG_SERVICE,'
      ' FLG_SERVICE_ENGINER'
      'FROM '
      ' VW_TS_USER_GROUPS'
      'WHERE'
      ' GROUPID = :GROUPID')
    SQLLock.Strings = (
      'SELECT NULL FROM TS_USER_GROUPS'
      'WHERE'
      'GROUPID = :Old_GROUPID'
      'FOR UPDATE WITH LOCK')
    Connection = dmDB.IBCConnection
    Transaction = dmDB.IBCTrDefaultSelect
    UpdateTransaction = IBCTrUpdateGroups
    SQL.Strings = (
      'SELECT'
      ' GROUPID,'
      ' NAME,'
      ' STRUCTURE_MASK,'
      ' FLG_SERVICE,'
      ' FLG_SERVICE_ENGINER'
      'FROM'
      ' VW_TS_USER_GROUPS')
    AutoCommit = False
    LockMode = lmLockImmediate
    RefreshOptions = [roAfterInsert, roAfterUpdate]
    Left = 68
    Top = 212
  end
  object IBCTrUpdateGroups: TIBCTransaction
    DefaultConnection = dmDB.IBCConnection
    Left = 68
    Top = 272
  end
  object IBCQueryUsers: TIBCQuery
    Connection = dmDB.IBCConnection
    SQL.Strings = (
      'SELECT'
      ' TS_USERS.USERID,'
      ' TS_USERS.FULL_NAME,'
      ' GET_FLG_VALUE(TS_USERS.FLAGS,0) FLG_ACTIVE,'
      ' TS_USER_GROUP_LINKS.GROUPID,'
      ' TS_USERS.DEFAULT_DT,'
      
        ' (SELECT DISPLAYNAME FROM TS_CUSTOMER WHERE TS_CUSTOMER.CUSTOMER' +
