  object IBCQueryCallsWav: TIBCQuery
    KeyFields = 'CALLID'
    SQLInsert.Strings = (
      'INSERT INTO TS_PHONE_CALLS_REGISTER'
      '  (CALLID, WAV, DURATION, SOURCEID, DESTID)'
      'VALUES'
      '  (:CALLID, :WAV, :DURATION, :SOURCEID, :DESTID)')
    SQLDelete.Strings = (
      'DELETE FROM TS_PHONE_CALLS_REGISTER'
      'WHERE'
      '  CALLID = :Old_CALLID')
    SQLUpdate.Strings = (
      'UPDATE TS_PHONE_CALLS_REGISTER'
      'SET'
      
        '  CALLID = :CALLID, WAV = :WAV, DURATION = :DURATION, SOURCEID =' +
        ' :SOURCEID, DESTID = :DESTID'
      'WHERE'
      '  CALLID = :Old_CALLID')
    SQLRefresh.Strings = (
      
        'SELECT CALLID, WAV, DURATION, SOURCEID, DESTID FROM TS_PHONE_CAL' +
        'LS_REGISTER'
      'WHERE'
      '  CALLID = :CALLID')
    SQLLock.Strings = (
      'SELECT NULL FROM TS_PHONE_CALLS_REGISTER'
      'WHERE'
      'CALLID = :Old_CALLID'
      'FOR UPDATE WITH LOCK')
    SQLRecCount.Strings = (
      'SELECT COUNT(*) FROM ('
      'SELECT 1 AS C  FROM TS_PHONE_CALLS_REGISTER'
      ''
      ') q')
    Connection = dmDB.IBCConnection
    Transaction = IBCTrSipSelect
    UpdateTransaction = IBCTrSipUpdate
    SQL.Strings = (
      'select * from TS_PHONE_CALLS_REGISTER where callid=:callid')
    MasterFields = 'CALLID'
    DetailFields = 'CALLID'
    MasterSource = IBCDataSourceCallHistory
    Left = 16
    Top = 441
    ParamData = <
      item
        DataType = ftInteger
        Name = 'callid'
        ParamType = ptInput
        Value = nil
      end
      item
        DataType = ftInteger
        Name = 'CALLID'
        ParamType = ptInput
        Value = nil
      end>
  end
