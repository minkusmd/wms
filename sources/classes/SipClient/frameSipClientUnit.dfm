  object IBCQueryActiveUsers: TIBCQuery
    Connection = dmDB.IBCConnection
    Transaction = IBCTrSipSelect
    UpdateTransaction = IBCTrSipUpdate
    SQL.Strings = (
      
        'select (U.FIRST_NAME || '#39' '#39' || U.LAST_NAME) FULLNAME, U.SIP_USER' +
        'ID'
      'from TS_USERS U'
      'where U.SIP_USERID > 0 and'
      '      GET_FLG_VALUE(U.FLAGS, 0) = 1'
      'union all'
      'select '#39'Grupa Mobila'#39', 2000'
      'from RDB$DATABASE'
      'union all'
      'select '#39'Grupa IT'#39', 1000'
      'from RDB$DATABASE'
      'order by 2')
    Left = 265
    Top = 296
  end
