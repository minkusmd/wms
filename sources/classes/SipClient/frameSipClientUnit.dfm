  object IBCQueryCallerHistory: TIBCQuery
    Connection = dmDB.IBCConnection
    Transaction = IBCTrSipSelect
    UpdateTransaction = IBCTrSipUpdate
    SQL.Strings = (
      'select first 50 * from ('
      
        'select u.full_name, p.data, p.calltypeid from ts_phone_calls_his' +
        'tory p'
      'inner join ts_users u on u.userid=p.userid'
      'where p.phonenumber containing :phonenumber'
      'order by p.data desc)')
    Options.RequiredFields = False
    Options.DefaultValues = True
    LocalConstraints = False
    Left = 40
    Top = 296
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'phonenumber'
        Value = nil
      end>
  end
