  object IBCDataSourceCallHistory: TIBCDataSource
    DataSet = IBCCallHistory
    Left = 181
    Top = 243
  end
  object IBCCallHistory: TIBCQuery
    KeyFields = 'CALLID'
    KeyGenerator = 'GEN_TS_PHONE_CALLS_HISTORY_ID'
    SQLInsert.Strings = (
      'INSERT INTO TS_PHONE_CALLS_HISTORY'
      
        '  (CALLID, USERID, DATA, CALLTYPEID, PHONENUMBER, DOCID, CUSTOME' +
        'RID, NICKNAME)'
      'VALUES'
      
        '  (:CALLID, :USERID, :DATA, :CALLTYPEID, :PHONENUMBER, :DOCID, :' +
        'CUSTOMERID, :NICKNAME)')
    SQLDelete.Strings = (
      'DELETE FROM TS_PHONE_CALLS_HISTORY'
      'WHERE'
      '  CALLID = :Old_CALLID')
    SQLUpdate.Strings = (
      'UPDATE TS_PHONE_CALLS_HISTORY'
      'SET'
      
        '  CALLID = :CALLID, USERID = :USERID, DATA = :DATA, CALLTYPEID =' +
        ' :CALLTYPEID, PHONENUMBER = :PHONENUMBER, DOCID = :DOCID, CUSTOM' +
        'ERID = :CUSTOMERID, NICKNAME = :NICKNAME'
      'WHERE'
      '  CALLID = :Old_CALLID')
    SQLRefresh.Strings = (
      
        'SELECT CALLID, USERID, DATA, CALLTYPEID, PHONENUMBER, DOCID, CUS' +
        'TOMERID, NICKNAME FROM TS_PHONE_CALLS_HISTORY'
      'WHERE'
      '  CALLID = :CALLID')
    SQLLock.Strings = (
      'SELECT NULL FROM TS_PHONE_CALLS_HISTORY'
      'WHERE'
      'CALLID = :Old_CALLID'
      'FOR UPDATE WITH LOCK')
    SQLRecCount.Strings = (
      'SELECT COUNT(*) FROM ('
      'SELECT 1 AS C  FROM TS_PHONE_CALLS_HISTORY'
      ''
      ') q')
    Connection = dmDB.IBCConnection
    Transaction = IBCTrSipSelect
    UpdateTransaction = IBCTrSipUpdate
    SQL.Strings = (
      
        'select ch.nickname, ch.customerid, ch.docid, ch.phonenumber, ch.' +
        'calltypeid, '
      '       ch.data, ch.userid, ch.callid,'
      
        'iif(exists (select callid from ts_phone_calls_register zz where ' +
        'zz.callid=ch.callid),1,0) FLG_HAS_WAV'
      'from TS_PHONE_CALLS_HISTORY  ch'
      'where ch.data >= (current_date - 1)'
      'order by ch.data desc')
    Options.RequiredFields = False
    Options.DefaultValues = True
    LocalConstraints = False
    BeforePost = IBCCallHistoryBeforePost
    Left = 182
    Top = 290
  end
