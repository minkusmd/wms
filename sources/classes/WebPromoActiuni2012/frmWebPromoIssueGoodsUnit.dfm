  object IBCQueryInfo: TIBCQuery
    SQLInsert.Strings = (
      'INSERT INTO VW_TWEB_PA_TOVAR'
      
        '  (PROMOACTIONID, IMAGE_ICON, TITLE_ROM, TEXT_ROM, TITLE_RUS, TE' +
        'XT_RUS, CATALOG_BTN_ROM, CATALOG_BTN_RUS, FLG_HIDE_CATALOG_BUTTO' +
        'N, CREATED_BY, CREATED_BY_NAME, BACKGROUND_COLOR, FONT_COLOR)'
      'VALUES'
      
        '  (:PROMOACTIONID, :IMAGE_ICON, :TITLE_ROM, :TEXT_ROM, :TITLE_RU' +
        'S, :TEXT_RUS, :CATALOG_BTN_ROM, :CATALOG_BTN_RUS, :FLG_HIDE_CATA' +
        'LOG_BUTTON, :CREATED_BY, :CREATED_BY_NAME, :BACKGROUND_COLOR, :F' +
        'ONT_COLOR)')
    SQLDelete.Strings = (
      'DELETE FROM VW_TWEB_PA_TOVAR'
      'WHERE'
      '  PROMOACTIONID = :Old_PROMOACTIONID')
    SQLUpdate.Strings = (
      'UPDATE VW_TWEB_PA_TOVAR'
      'SET'
      
        '  PROMOACTIONID = :PROMOACTIONID, IMAGE_ICON = :IMAGE_ICON, TITL' +
        'E_ROM = :TITLE_ROM, TEXT_ROM = :TEXT_ROM, TITLE_RUS = :TITLE_RUS' +
        ', TEXT_RUS = :TEXT_RUS, CATALOG_BTN_ROM = :CATALOG_BTN_ROM, CATA' +
        'LOG_BTN_RUS = :CATALOG_BTN_RUS, FLG_HIDE_CATALOG_BUTTON = :FLG_H' +
        'IDE_CATALOG_BUTTON, CREATED_BY = :CREATED_BY, CREATED_BY_NAME = ' +
        ':CREATED_BY_NAME, BACKGROUND_COLOR = :BACKGROUND_COLOR, FONT_COL' +
        'OR = :FONT_COLOR'
      'WHERE'
      '  PROMOACTIONID = :Old_PROMOACTIONID')
    SQLRefresh.Strings = (
      
        'SELECT PROMOACTIONID, IMAGE_ICON, TITLE_ROM, TEXT_ROM, TITLE_RUS' +
        ', TEXT_RUS, CATALOG_BTN_ROM, CATALOG_BTN_RUS, FLG_HIDE_CATALOG_B' +
        'UTTON, CREATED_BY, CREATED_BY_NAME, BACKGROUND_COLOR, FONT_COLOR' +
        ' FROM VW_TWEB_PA_TOVAR'
      'WHERE'
      '  PROMOACTIONID = :PROMOACTIONID')
    SQLLock.Strings = (
      'SELECT NULL FROM TWEB_PA_TOVAR'
      'WHERE'
      'PROMOACTIONID = :Old_PROMOACTIONID'
      'FOR UPDATE WITH LOCK')
    SQLRecCount.Strings = (
      'SELECT COUNT(*) FROM ('
      'SELECT 1 AS C  FROM VW_TWEB_PA_TOVAR'
      ''
      ') q')
    Connection = dmDB.IBCConnection
    Transaction = dmDB.IBCTrDefaultSelect
    SQL.Strings = (
      'SELECT'
      '*'
      'FROM VW_TWEB_PA_TOVAR'
      'WHERE PROMOACTIONID=:ID')
    AutoCommit = False
    LockMode = lmLockImmediate
    Left = 329
    Top = 209
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ID'
        Value = nil
      end>
  end
