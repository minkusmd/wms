    Top = 8
  end
  object IBCQueryCustomerType: TIBCQuery
    SQL.Strings = (
      'SELECT'
      '    CUSTOMERTYPEID,'
      '    TITLE,'
      '    DESCRIPTION'
      'FROM'
      '    GET_CUSTOMER_TYPES'
      'WHERE'
      ' CUSTOMERTYPEID<>4009')
    Left = 652
    Top = 300
  end
  object IBCDataSourceCustomerType: TIBCDataSource
    DataSet = IBCQueryCustomerType
    Left = 532
    Top = 300
  end
  object IBCQueryCustomerStatus: TIBCQuery
    SQL.Strings = (
      'SELECT'
      '    CUSTOMERSTATUSID,'
