  object IBCQueryCity: TIBCQuery
    SQL.Strings = (
      'SELECT'
      ' CITYID,'
      ' TITLE,'
      ' DISTRICT_TITLE,'
      ' ZIP_CODE'
      'FROM'
      ' GET_CITIES')
    Left = 532
    Top = 228
  end
