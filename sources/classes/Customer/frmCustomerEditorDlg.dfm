  object IBCQueryLogPC: TIBCQuery
    SQL.Strings = (
      'SELECT'
      'A.*,'
      
        '(SELECT FULL_NAME FROM TS_USERS WHERE TS_USERS.USERID=A.USERID) ' +
        'USER_NAME,'
      'COALESCE(A.COLUMN_OLD,'#39'*'#39') || '#39'->'#39' || A.COLUMN_NEW CHANGES'
      'FROM TLOG_CUST_PRICECOLUMN A'
      'WHERE CUSTOMERID=:ID'
      'ORDER BY DATA_CHANGED DESC')
    Left = 660
    Top = 228
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'ID'
        Value = nil
      end>
  end
  object IBCDataSourceLogPC: TIBCDataSource
    DataSet = IBCQueryLogPC
    Left = 771
    Top = 89
  end
