  object IBCQueryNewGoodsSupplier: TIBCQuery
    KeyFields = 'SUPPLIER_GOODS_CODE'
    SQLRefresh.Strings = (
      
        'select gf.goodsid, PLI1.*, PLI1.PRICE0 NEW_PRICE0, 1 FLG_IN_PRIC' +
        'E, GET_FLG_VALUE(PLI1.FLAGS, 4) FLG_EPP'
      'from TS_PRICELIST_ITEMS PLI1'
      
        'left outer join ts_goods_foreign gf on gf.goods_code=pli1.suppli' +
        'er_goods_code'
      'where PLI1.PLID = :NEW_PLID and'
      '      not exists(select *'
      '                 from TS_PRICELIST_ITEMS PLI2'
      '                 where PLI2.PLID = :OLD_PLID  and'
      
        '                       PLI1.SUPPLIER_GOODS_CODE = PLI2.SUPPLIER_' +
        'GOODS_CODE) and'
      '      pli1.supplier_goods_code = :SUPPLIER_GOODS_CODE')
    Connection = dmDB.IBCConnection
    Transaction = dmDB.IBCTrDefaultSelect
    UpdateTransaction = dmDB.IBCTrDefaultUpdate
    SQL.Strings = (
      
        'select gf.goodsid, PLI1.*, PLI1.PRICE0 NEW_PRICE0, 1 FLG_IN_PRIC' +
        'E, GET_FLG_VALUE(PLI1.FLAGS, 4) FLG_EPP'
      'from TS_PRICELIST_ITEMS PLI1'
      'join ts_pricelists on ts_pricelists.plid = pli1.plid'
      
        'left outer join ts_goods_foreign gf on gf.goods_code=pli1.suppli' +
        'er_goods_code and gf.customerid = ts_pricelists.supplierid'
      'where PLI1.PLID = :NEW_PLID and'
      '      not exists(select *'
      '                 from TS_PRICELIST_ITEMS PLI2'
      '                 where PLI2.PLID = :OLD_PLID  and'
      
        '                       PLI1.SUPPLIER_GOODS_CODE = PLI2.SUPPLIER_' +
        'GOODS_CODE )')
    Left = 576
    Top = 505
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'new_PLID'
        Value = nil
      end
      item
        DataType = ftUnknown
        Name = 'old_plid'
        Value = nil
      end>
  end
