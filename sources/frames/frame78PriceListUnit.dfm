  object IBCQueryPriceItems: TIBCQuery
    KeyFields = ' PLID;SUPPLIER_GOODS_CODE'
    SQLInsert.Strings = (
      'INSERT INTO VW_TS_PRICELIST_ITEMS'
      
        '  (PLID, SUPPLIERID, SUPPLIER_GOODS_CODE, GOODSID, SUPPLIER_GOOD' +
        'S_NAME, STOCK_QTY, FLAGS, FLG_EPP, PRICE0, CURRENCY0ID, PRICE3, ' +
        'CURRENCY3ID, CURRENCY3_NAME, PRICE7, CURRENCY7ID, CURRENCY7_NAME' +
        ', WARANTY, SUPPLIER_GOODS_BRAND, SUPPLIER_GOODS_MODEL, SUPPLIER_' +
        'GOODSTYPE, GOODSTYPEID, GOODSTYPE_NAME, SYSTEM_VENDORID, SYSTEM_' +
        'VENDOR_NAME, PARENTGOODSID, PARENTGOODS_NAME, SYSTEM_UMID, SUPPL' +
        'IER_CATEGORY, TITLE, WEBGOODSTYPE_ID, WEBGOODSTYPE_NAME, CODE, B' +
        'ASE_PARAM, CODE_RU, BASE_PARAM_RU, DETAILS, VENDOR_ID, VENDOR_NA' +
        'ME, COMPATIBILITATE, FLG_PREORDER, product_link)'
      'VALUES'
      
        '  (:PLID, :SUPPLIERID, :SUPPLIER_GOODS_CODE, :GOODSID, :SUPPLIER' +
        '_GOODS_NAME, :STOCK_QTY, :FLAGS, :FLG_EPP, :PRICE0, :CURRENCY0ID' +
        ', :PRICE3, :CURRENCY3ID, :CURRENCY3_NAME, :PRICE7, :CURRENCY7ID,' +
        ' :CURRENCY7_NAME, :WARANTY, :SUPPLIER_GOODS_BRAND, :SUPPLIER_GOO' +
        'DS_MODEL, :SUPPLIER_GOODSTYPE, :GOODSTYPEID, :GOODSTYPE_NAME, :S' +
        'YSTEM_VENDORID, :SYSTEM_VENDOR_NAME, :PARENTGOODSID, :PARENTGOOD' +
        'S_NAME, :SYSTEM_UMID, :SUPPLIER_CATEGORY, :TITLE, :WEBGOODSTYPE_' +
        'ID, :WEBGOODSTYPE_NAME, :CODE, :BASE_PARAM, :CODE_RU, :BASE_PARA' +
        'M_RU, :DETAILS, :VENDOR_ID, :VENDOR_NAME, :COMPATIBILITATE, :FLG' +
        '_PREORDER, :product_link)')
    SQLDelete.Strings = (
      'DELETE FROM VW_TS_PRICELIST_ITEMS'
      'WHERE'
      
        '  PLID = :Old_PLID AND SUPPLIER_GOODS_CODE = :Old_SUPPLIER_GOODS' +
        '_CODE')
    SQLUpdate.Strings = (
      'UPDATE VW_TS_PRICELIST_ITEMS'
      'SET'
      
        '  PLID = :PLID, SUPPLIERID = :SUPPLIERID, SUPPLIER_GOODS_CODE = ' +
        ':SUPPLIER_GOODS_CODE, GOODSID = :GOODSID, SUPPLIER_GOODS_NAME = ' +
        ':SUPPLIER_GOODS_NAME, STOCK_QTY = :STOCK_QTY, FLAGS = :FLAGS, FL' +
        'G_EPP = :FLG_EPP, PRICE0 = :PRICE0, CURRENCY0ID = :CURRENCY0ID, ' +
        'PRICE3 = :PRICE3, CURRENCY3ID = :CURRENCY3ID, CURRENCY3_NAME = :' +
        'CURRENCY3_NAME, PRICE7 = :PRICE7, CURRENCY7ID = :CURRENCY7ID, CU' +
        'RRENCY7_NAME = :CURRENCY7_NAME, WARANTY = :WARANTY, SUPPLIER_GOO' +
        'DS_BRAND = :SUPPLIER_GOODS_BRAND, SUPPLIER_GOODS_MODEL = :SUPPLI' +
        'ER_GOODS_MODEL, SUPPLIER_GOODSTYPE = :SUPPLIER_GOODSTYPE, GOODST' +
        'YPEID = :GOODSTYPEID, GOODSTYPE_NAME = :GOODSTYPE_NAME, SYSTEM_V' +
        'ENDORID = :SYSTEM_VENDORID, SYSTEM_VENDOR_NAME = :SYSTEM_VENDOR_' +
        'NAME, PARENTGOODSID = :PARENTGOODSID, PARENTGOODS_NAME = :PARENT' +
        'GOODS_NAME, SYSTEM_UMID = :SYSTEM_UMID, SUPPLIER_CATEGORY = :SUP' +
        'PLIER_CATEGORY, TITLE = :TITLE, WEBGOODSTYPE_ID = :WEBGOODSTYPE_' +
        'ID, WEBGOODSTYPE_NAME = :WEBGOODSTYPE_NAME, CODE = :CODE, BASE_P' +
        'ARAM = :BASE_PARAM, CODE_RU = :CODE_RU, BASE_PARAM_RU = :BASE_PA' +
        'RAM_RU, DETAILS = :DETAILS, VENDOR_ID = :VENDOR_ID, VENDOR_NAME ' +
        '= :VENDOR_NAME, COMPATIBILITATE = :COMPATIBILITATE, FLG_PREORDER' +
        ' = :FLG_PREORDER, product_link = :product_link'
      'WHERE'
      
        '  PLID = :Old_PLID AND SUPPLIER_GOODS_CODE = :Old_SUPPLIER_GOODS' +
        '_CODE')
    SQLRefresh.Strings = (
      'SELECT * FROM VW_TS_PRICELIST_ITEMS'
      'WHERE'
      '  PLID = :PLID AND SUPPLIER_GOODS_CODE = :SUPPLIER_GOODS_CODE')
    SQLLock.Strings = (
      'SELECT NULL FROM VW_TS_PRICELIST_ITEMS'
      'WHERE'
      
        'PLID = :Old_PLID AND SUPPLIER_GOODS_CODE = :Old_SUPPLIER_GOODS_C' +
        'ODE'
      'FOR UPDATE WITH LOCK')
    SQLRecCount.Strings = (
      'SELECT COUNT(*) FROM ('
      'SELECT 1 AS C  FROM VW_TS_PRICELIST_ITEMS'
      ''
      ') q')
    Connection = dmDB.IBCConnection
    Transaction = dmDB.IBCTrDefaultSelect
    UpdateTransaction = dmDB.IBCTrDefaultUpdate
    SQL.Strings = (
      
        'select pi.*, GET_FLG_IN_PRICE(GOODSID) FLG_IN_PRICE, /*get_flg_v' +
        'alue(flags, 4)*/ FLG_EPP,'
      
        'iif(exists(select * from TS_GOODS_IMAGE GI where GI.GOODSID = pi' +
        '.GOODSID), 1, 0) FLG_HAS_IMAGE,'
      
        '       round(iif(coalesce(price3, 0) <> 0, ((c3.EXCHANGE_RATE * ' +
        'PRICE3 - c7.EXCHANGE_RATE * PRICE7) /'
      '        (c3.EXCHANGE_RATE * PRICE3)) * 100, 0),2) as MARGIN71, '
      '        round(pi.price3 * c3.exchange_rate, 0) PRICE_RRP_LEI,'
      '        round(pi.price7 * c7.exchange_rate, 0) PRICE7_LEI'
      'from VW_TS_PRICELIST_ITEMS pi'
      'left outer join ts_currency c3 on c3.currencyid = currency3id'
      'left outer join ts_currency c7 on c7.currencyid = currency7id'
      'where pi.PLID = :PLID')
    MasterFields = 'PLID'
    DetailFields = 'PLID'
    MasterSource = IBCDataSourcePriceData
    RefreshOptions = [roAfterInsert, roAfterUpdate]
    Left = 544
    Top = 224
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'plid'
        Value = nil
      end
      item
        DataType = ftUnknown
        Name = 'PLID'
        Value = nil
      end>
  end
  object IBCDataSourcePriceItems: TIBCDataSource
    DataSet = IBCQueryPriceItems
    Left = 544
    Top = 168
  end
  object IBCQueryPriceData: TIBCQuery
    KeyFields = 'PLID'
    KeyGenerator = 'GEN_TS_PRICELISTS_ID'
    SQLInsert.Strings = (
      'INSERT INTO VW_TS_PRICELISTS'
      '  (PLID, SUPPLIERID, price_categoryid, DATA, MENTIUNI, FLG_DONE)'
      'VALUES'
      
        '  (:PLID, :SUPPLIERID, :price_categoryid, :DATA, :MENTIUNI, :FLG' +
        '_DONE)')
    SQLDelete.Strings = (
      'DELETE FROM TS_PRICELISTS'
      'WHERE'
      '  PLID = :Old_PLID')
    SQLUpdate.Strings = (
      'UPDATE vw_TS_PRICELISTS'
      'SET'
      
        '  PLID = :PLID, SUPPLIERID = :SUPPLIERID, DATA = :DATA, MENTIUNI' +
        ' = :MENTIUNI,  '
      '  price_categoryid = :price_categoryid,'
      '  FLG_DONE = :FLG_DONE'
      'WHERE'
      '  PLID = :Old_PLID')
    SQLRefresh.Strings = (
      'SELECT * FROM VW_TS_PRICELISTS'
      'WHERE'
      '  PLID = :PLID')
    SQLLock.Strings = (
      'SELECT NULL FROM TS_PRICELISTS'
      'WHERE'
      'PLID = :Old_PLID'
      'FOR UPDATE WITH LOCK')
    SQLRecCount.Strings = (
      'SELECT COUNT(*) FROM ('
      'SELECT 1 AS C  FROM TS_PRICELISTS'
      ''
      ') q')
    Connection = dmDB.IBCConnection
    Transaction = dmDB.IBCTrDefaultSelect
    UpdateTransaction = dmDB.IBCTrDefaultUpdate
    SQL.Strings = (
      'select '
      '  plid, '
      '  supplierid, '
      '  price_categoryid,'
      '  DATA, '
      '  MENTIUNI, '
      
        '  (select (last_name ||'#39' '#39'||first_name) from ts_users u where u.' +
        'userid = created_by) created_by_name,'
      '  FLG_DONE'
      'from vw_TS_PRICELISTS '
      
        'where supplierid=:supplierid and price_categoryid = :price_categ' +
        'oryid'
      'order by plid desc ')
    RefreshOptions = [roAfterInsert, roAfterUpdate]
    Left = 361
    Top = 208
    ParamData = <
      item
        DataType = ftInteger
        Name = 'supplierid'
        ParamType = ptInput
        Value = 202294
      end
      item
        DataType = ftUnknown
        Name = 'price_categoryid'
        Value = nil
      end>
  end
  object IBCDataSourcePriceData: TIBCDataSource
    DataSet = IBCQueryPriceData
    Left = 360
    Top = 160
  end
