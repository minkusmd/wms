  object IBCQueryPriceToCompare: TIBCQuery
    KeyFields = 'PLID'
    SQLInsert.Strings = (
      'INSERT INTO TS_PRICELISTS'
      '  (PLID, SUPPLIERID, price_categoryid, DATA, MENTIUNI)'
      'VALUES'
      '  (:PLID, :SUPPLIERID, :price_categoryid, :DATA, :MENTIUNI)')
    SQLDelete.Strings = (
      'DELETE FROM TS_PRICELISTS'
      'WHERE'
      '  PLID = :Old_PLID')
    SQLUpdate.Strings = (
      'UPDATE TS_PRICELISTS'
      'SET'
      
        '  PLID = :PLID, SUPPLIERID = :SUPPLIERID, DATA = :DATA, MENTIUNI' +
        ' = :MENTIUNI,  price_categoryid = :price_categoryid'
      'WHERE'
      '  PLID = :Old_PLID')
    SQLRefresh.Strings = (
      'SELECT * FROM TS_PRICELISTS'
      'WHERE'
      '  PLID = :PLID')
    SQLLock.Strings = (
      'SELECT NULL FROM TS_PRICELISTS'
      'WHERE'
      'PLID = :Old_PLID'
      'FOR UPDATE WITH LOCK')
    SQLRecCount.Strings = (
      'SELECT COUNT(*) FROM ('
      'SELECT 1 AS C  FROM TS_PRICELISTS'
      ''
      ') q')
    Connection = dmDB.IBCConnection
    Transaction = dmDB.IBCTrDefaultSelect
    UpdateTransaction = dmDB.IBCTrDefaultUpdate
    SQL.Strings = (
      'select first 15'
      '  plid, '
      '  supplierid, '
      '  price_categoryid,'
      '  DATA, '
      '  MENTIUNI, '
      
        '  (select (last_name ||'#39' '#39'||first_name) from ts_users u where u.' +
        'userid = created_by) created_by_name'
      'from TS_PRICELISTS '
      
        'where supplierid=:supplierid and price_categoryid = :price_categ' +
        'oryid and plid <> :plid'
      'order by plid desc ')
    RefreshOptions = [roAfterInsert, roAfterUpdate]
    Left = 240
    Top = 216
    ParamData = <
      item
        DataType = ftInteger
        Name = 'supplierid'
        ParamType = ptInput
        Value = 202294
      end
      item
        DataType = ftUnknown
        Name = 'price_categoryid'
        Value = nil
      end
      item
        DataType = ftUnknown
        Name = 'plid'
        Value = nil
      end>
  end
