  object IBCQueryNewGoods: TIBCQuery
    Connection = dmDB.IBCConnection
    SQL.Strings = (
      
        'select gf.goodsid, pli1.*, pli1.price0 new_price0, 1 flg_in_pric' +
        'e, get_flg_value(gf.flags, 4) flg_epp'
      'from ts_pricelist_items pli1'
      
        'join ts_goods_foreign gf on (gf.goods_code = pli1.supplier_goods' +
        '_code and gf.customerid = :supplierid)'
      'where pli1.plid = :new_plid and'
      '      not exists(select 1'
      '                 from ts_goods_foreign gfo'
      
        '                 where (gfo.goods_code = pli1.supplier_goods_cod' +
        'e and'
      '                       gfo.customerid = :supplierid and'
      '                       get_flg_value(gfo.flags, 3) = 1))')
    Left = 384
    Top = 361
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'supplierid'
        Value = nil
      end
      item
        DataType = ftUnknown
        Name = 'new_PLID'
        Value = nil
      end
      item
        DataType = ftUnknown
        Name = 'supplierid'
        Value = nil
      end>
  end
  object IBCQueryOldGoods: TIBCQuery
    Connection = dmDB.IBCConnection
    SQL.Strings = (
      'SELECT'
      '    gf.GOODS_CODE               AS SUPPLIER_GOODS_CODE,'
      '    gf.PRICE0                   AS NEW_PRICE0,'
      '    gf.PRICE3                   AS NEW_PRICE3,'
      '    gf.PRICE7                   AS NEW_PRICE7,'
      '    gf.CURRENCY3ID,'
      '    gf.CURRENCY7ID,'
      '    gf.GOODS_TITLE              AS SUPPLIER_GOODS_NAME,'
      '    gf.GOODSID,'
      '    get_flg_value(gf.FLAGS, 3)  AS FLG_IN_PRICE,'
      '    get_flg_value(gf.FLAGS, 4)  AS FLG_EPP'
      'FROM TS_GOODS_FOREIGN gf'
      'JOIN TS_PRICELISTS pl ON pl.PLID = :NEW_PLID'
      'WHERE gf.CUSTOMERID = pl.SUPPLIERID'
      '  AND get_flg_value(gf.FLAGS, 3) = 1'
      '  AND NOT EXISTS ('
      '      SELECT 1'
      '      FROM TS_PRICELIST_ITEMS pi'
      '      WHERE pi.PLID                = pl.PLID'
      '        AND pi.SUPPLIER_GOODS_CODE = gf.GOODS_CODE'
      '  )')
    Left = 543
    Top = 361
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'NEW_PLID'
        Value = nil
      end>
  end
  object IBCDataSourceOldGoods: TIBCDataSource
    DataSet = IBCQueryOldGoods
    Left = 544
    Top = 304
  end
  object IBCDataSourcePricesUp: TIBCDataSource
    DataSet = IBCQueryPricesUp
    Left = 688
    Top = 304
  end
  object IBCQueryPricesUp: TIBCQuery
    Connection = dmDB.IBCConnection
    SQL.Strings = (
      
        'select P_new.plid, pl.supplierid, P_new.SUPPLIER_GOODS_CODE, gf.' +
        'PRICE0 OLD_PRICE0,'
      '       gf.PRICE3 OLD_PRICE3, P_NEW.CURRENCY3ID NEW_CURRENCY3ID,'
      '       gf.PRICE7 OLD_PRICE7, P_NEW.CURRENCY7ID NEW_CURRENCY7ID,'
      
        '       P_NEW.PRICE7 - gf.PRICE7 DEVIATION, P_NEW.SUPPLIER_GOODS_' +
        'NAME,'
      '       P_NEW.PRICE0 NEW_PRICE0, P_NEW.PRICE3 NEW_PRICE3,'
      
        '       P_NEW.PRICE7 NEW_PRICE7, P_NEW.PRICE3 - gf.PRICE3 DEVIATI' +
        'ON3,'
      
        '       GF.GOODSID GOODSID, GET_FLG_IN_PRICE(GF.GOODSID) FLG_IN_P' +
        'RICE,'
      'get_flg_value(GF.flags, 4) flg_epp '
      'from TS_PRICELIST_ITEMS P_NEW'
      'join ts_pricelists pl on pl.plid = p_new.plid'
      
        'join TS_GOODS_FOREIGN GF on (GF.GOODS_CODE = P_NEW.SUPPLIER_GOOD' +
        'S_CODE and GF.CUSTOMERID = pl.supplierid) and'
      '      ('
      
        '          (coalesce(P_NEW.PRICE7, 0) > coalesce(gf.PRICE7, 0)) o' +
        'r'
      
        '          (coalesce(P_NEW.PRICE0, 0) > 0 and coalesce(P_NEW.PRIC' +
        'E0, 0) > coalesce(gf.PRICE0, 0)) or'
      
        '          iif(get_flg_value(GF.flags, 4) = 1, (coalesce(P_NEW.PR' +
        'ICE3, 0) > coalesce(gf.PRICE3, 0)), false) '
      '      )'
      'where p_new.plid = :new_plid and GET_FLG_IN_PRICE(GF.GOODSID)=1'
      ''
      '/*select P_OLD.SUPPLIER_GOODS_CODE, P_OLD.PRICE0 OLD_PRICE0,'
      
        '       P_OLD.PRICE3 OLD_PRICE3, P_NEW.CURRENCY3ID NEW_CURRENCY3I' +
        'D,'
      
        '       P_OLD.PRICE7 OLD_PRICE7, P_NEW.CURRENCY7ID NEW_CURRENCY7I' +
        'D,'
      
        '       P_NEW.PRICE7 - P_OLD.PRICE7 DEVIATION, P_NEW.SUPPLIER_GOO' +
        'DS_NAME,'
      '       P_NEW.PRICE0 NEW_PRICE0, P_NEW.PRICE3 NEW_PRICE3,'
      
        '       P_NEW.PRICE7 NEW_PRICE7, P_NEW.PRICE3 - P_OLD.PRICE3 DEVI' +
        'ATION3,'
      
        '       GF.GOODSID GOODSID, GET_FLG_IN_PRICE(GF.GOODSID) FLG_IN_P' +
        'RICE,'
      'get_flg_value(GF.flags, 4) flg_epp '
      'from TS_PRICELIST_ITEMS P_NEW'
      
        'inner join TS_PRICELIST_ITEMS P_OLD on P_NEW.PLID = :NEW_PLID an' +
        'd'
      '      P_NEW.SUPPLIER_GOODS_CODE = P_OLD.SUPPLIER_GOODS_CODE and'
      '      ('
      
        '          (coalesce(P_NEW.PRICE7, 0) > coalesce(P_OLD.PRICE7, 0)' +
        ') or'
      
        '          (coalesce(P_NEW.PRICE3, 0) > coalesce(P_OLD.PRICE3, 0)' +
        ') or'
      
        '          (coalesce(P_NEW.PRICE0, 0) > coalesce(P_OLD.PRICE0, 0)' +
        ' )'
      '      ) and'
      '      P_OLD.PLID = :OLD_PLID'
      
        'join TS_GOODS_FOREIGN GF on (GF.GOODS_CODE = P_NEW.SUPPLIER_GOOD' +
        'S_CODE and'
      '      GF.CUSTOMERID = :SUPPLIERID)'
      '*/')
    Left = 688
    Top = 361
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'new_plid'
        Value = nil
      end>
  end
  object IBCQueryPricesDown: TIBCQuery
    Connection = dmDB.IBCConnection
    SQL.Strings = (
      
        'select P_old.plid, pl.supplierid, P_old.SUPPLIER_GOODS_CODE, gf.' +
        'PRICE0 OLD_PRICE0,'
      '       gf.PRICE3 OLD_PRICE3, P_old.CURRENCY3ID NEW_CURRENCY3ID,'
      '       gf.PRICE7 OLD_PRICE7, P_old.CURRENCY7ID NEW_CURRENCY7ID,'
      
        '       P_old.PRICE7 - gf.PRICE7 DEVIATION, P_old.SUPPLIER_GOODS_' +
        'NAME,'
      '       P_old.PRICE0 NEW_PRICE0, P_old.PRICE3 NEW_PRICE3,'
      
        '       P_old.PRICE7 NEW_PRICE7, P_old.PRICE3 - gf.PRICE3 DEVIATI' +
        'ON3,'
      
        '       GF.GOODSID GOODSID, GET_FLG_IN_PRICE(GF.GOODSID) FLG_IN_P' +
        'RICE,'
      'get_flg_value(GF.flags, 4) flg_epp '
      'from TS_PRICELIST_ITEMS P_old'
      'join ts_pricelists pl on pl.plid = P_old.plid'
      
        'join TS_GOODS_FOREIGN GF on (GF.GOODS_CODE = P_old.SUPPLIER_GOOD' +
        'S_CODE and GF.CUSTOMERID = pl.supplierid) and'
      '      ('
      
        '          (coalesce(P_old.PRICE7, 0) < coalesce(gf.PRICE7, 0)) o' +
        'r'
      
        '          (coalesce(P_old.PRICE0, 0) > 0 and coalesce(P_old.PRIC' +
        'E0, 0) < coalesce(gf.PRICE0, 0)) or'
      
        '          iif(get_flg_value(GF.flags, 4) = 1, (coalesce(P_old.PR' +
        'ICE3, 0) < coalesce(gf.PRICE3, 0)), false) '
      '      )'
      
        'where P_old.plid = :new_plid and (GET_FLG_IN_PRICE(GF.GOODSID) =' +
        ' 1)'
      ''
      ''
      '/*'
      'select P_OLD.SUPPLIER_GOODS_CODE, P_OLD.PRICE0 OLD_PRICE0,'
      
        '       P_OLD.PRICE3 OLD_PRICE3, P_NEW.CURRENCY3ID NEW_CURRENCY3I' +
        'D,'
      
        '       P_OLD.PRICE7 OLD_PRICE7, P_NEW.CURRENCY7ID NEW_CURRENCY7I' +
        'D,'
      
        '       P_NEW.PRICE7 - P_OLD.PRICE7 DEVIATION, P_NEW.SUPPLIER_GOO' +
        'DS_NAME,'
      '       P_NEW.PRICE0 NEW_PRICE0, P_NEW.PRICE3 NEW_PRICE3,'
      
        '       P_NEW.PRICE7 NEW_PRICE7, P_NEW.PRICE3 - P_OLD.PRICE3 DEVI' +
        'ATION3,'
      
        '       GF.GOODSID GOODSID, GET_FLG_IN_PRICE(GF.GOODSID) FLG_IN_P' +
        'RICE,'
      'get_flg_value(GF.flags, 4) flg_epp '
      'from TS_PRICELIST_ITEMS P_NEW'
      
        'inner join TS_PRICELIST_ITEMS P_OLD on P_NEW.PLID = :NEW_PLID an' +
        'd'
      '      P_NEW.SUPPLIER_GOODS_CODE = P_OLD.SUPPLIER_GOODS_CODE and'
      '      ('
      
        '          (coalesce(P_NEW.PRICE7, 0) < coalesce(P_OLD.PRICE7, 0)' +
        ') or '
      
        '          (coalesce(P_NEW.PRICE3, 0) < coalesce(P_OLD.PRICE3, 0)' +
        ') or '
      
        '          (coalesce(P_NEW.PRICE0, 0) < coalesce(P_OLD.PRICE0, 0)' +
        ' and '
      '             p_new.price0 is not null and '
      '             p_old.price0 is not null)'
      '      ) and'
      '      P_OLD.PLID = :OLD_PLID'
      
        'join TS_GOODS_FOREIGN GF on (GF.GOODS_CODE = P_NEW.SUPPLIER_GOOD' +
        'S_CODE and'
      '      GF.CUSTOMERID = :SUPPLIERID)'
      '*/')
    Left = 800
    Top = 360
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'new_plid'
        Value = nil
      end>
  end
