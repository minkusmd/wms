function EnsureAppDataFolder: string;
var
    Base: string;
    Target: string;
begin
  // incercam sa ob?inem %LOCALAPPDATA%
    if Get_LOCAL_APPDATA_Folder(Base) then
    begin
        Target := TPath.Combine(Base, 'SWN');
        if not TDirectory.Exists(Target) then
            TDirectory.CreateDirectory(Target);
        Result := IncludeTrailingPathDelimiter(Target);
    end
    else
    begin
    // fallback: langa exe
        Result := IncludeTrailingPathDelimiter(ExtractFilePath(ParamStr(0)));
    end;
end;

function GetConfigFilePath(const Root: string): string;
begin
    Result := TPath.Combine(Root, TPath.ChangeExtension(ExtractFileName(ParamStr(0)), '.config'));
end;

procedure LoadAppConfig(const Root: string);
var
    Cfg: string;
begin
    Cfg := GetConfigFilePath(Root);
    // LoadFromFile retine calea fisierului si atunci cand acesta nu exista inca,
    // altfel AutoSave nu are unde salva si setarile (inclusiv LastLogin) se pierd
    AppConfigStorage.LoadFromFile(Cfg);
    if not TFile.Exists(Cfg) then
    begin
        AppConfigStorage.SaveToFile(Cfg); // cream fisierul la prima rulare
    end;
    AppConfigStorage.AutoSave := True; // activam salvarea automata o singura data
end;

{$IFDEF DEBUG}
procedure SetupDebugConnection;
begin
  // DEBUG: utilizatorul 204 (sergiu) ?i parametrii implici?i de conexiune
    SetConnectionParams(204, cDATABASE_DBName, cDATABASE_ConnectionServerDefault, cDATABASE_ConnectionPortDefault, False);
end;
{$ENDIF}

{$IFNDEF DEBUG}

function DoLogin: Boolean;
begin
    Result := False;
    frmLogin := TfrmLoginDlg.Create(Application);
    try
        frmLogin.UpdaterAppName := cUPDATE_UpdaterFileName;

        if AppConfigStorage.BooleanValues.GetValue(cSETTINGS_AppSaveLastLogin, True) then
            LastUserName := AppConfigStorage.TextValues.GetValue(cSETTINGS_AppLastLogin, '');

        if LastUserName <> '' then
            frmLogin.UserName := LastUserName;

        frmLogin.DatabaseAlias := AppConfigStorage.TextValues.GetValue('DATABASE_ALIAS', cDATABASE_DBName);
        frmLogin.ServerAddress := AppConfigStorage.TextValues.GetValue('SERVER_ADDRESS', cDATABASE_ConnectionServerDefault);
        frmLogin.ServerPort := AppConfigStorage.IntValues.GetValue('SERVER_PORT', cDATABASE_ConnectionPortDefault);

        if frmLogin.ShowModal = mrOk then
        begin
            Result := frmLogin.Authentificated;
            if Result then
            begin
                SetConnectionParams(frmLogin.UserID, frmLogin.DatabaseAlias, frmLogin.ServerAddress, frmLogin.ServerPort, frmLogin.HasSecurityConfirmation);
            end;
        end;
    finally
        frmLogin.Free;
    end;
end;
{$ENDIF}

procedure CreateCoreForms;
begin
  // cream mai intai DM, apoi forma principala
  Application.CreateForm(TdmAdditions, dmAdditions);
  Application.CreateForm(TdmDB, dmDB);
  if dmDB.DBConnected then
        Application.CreateForm(TfrmMainForm, frmMainForm);
end;

procedure InitVisuals(const AppTitle: string);
begin
  // temele/stilurile pot fi activate aici daca e nevoie
  // TStyleManager.TrySetStyle('Windows10 Blue'); // exemplu, daca folosi?i stiluri
    Application.MainFormOnTaskbar := True;
    Application.Title := AppTitle;
end;

begin
//  ReportMemoryLeaksOnShutdown := {$IFDEF DEBUG}True{$ELSE}False{$ENDIF};

    try
        Application.Initialize;

    // 1) Folderul de date + config
        globalPATH_LOCAL_APPDATA := EnsureAppDataFolder;
        LoadAppConfig(globalPATH_LOCAL_APPDATA);

    // 2) Titlul ferestrei (numele aplica?iei, nu calea catre folder)
        InitVisuals(cAPP_Title);

    // 3) Autorizare
    {$IFDEF DEBUG}
        CanRun := True;
        SetupDebugConnection;
    {$ELSE}
        CanRun := DoLogin;
    {$ENDIF}

    // 4) Pornire
        if CanRun then
        begin
            CreateCoreForms;
            if Assigned(dmDB) and dmDB.DBConnected then
            begin
                Screen.Cursors[crSQLWait] := Screen.Cursors[crHourGlass];
                Application.Run;
            end
            else
            begin
        // Nu exista conexiune la BD — incheiem corect
                MessageDlg('Nu s-a putut stabili conexiunea la baza de date.', mtError, [mbOK], 0);
            end;
        end;

    except
        on E: Exception do
        begin
      // punct unic pentru erorile neprinse la pornire
      // madExcept preia stiva; aici — mesaj „prietenos”
            MessageDlg(Format('Eroare la pornire: %s'#13#10'%s', [E.ClassName, E.Message]), mtError, [mbOK], 0);
        end;
    end;
end.
