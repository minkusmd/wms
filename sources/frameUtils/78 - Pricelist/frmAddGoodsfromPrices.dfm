  object IBCQuerySearch: TIBCQuery
    SQLInsert.Strings = (
      'INSERT INTO VW_TS_GOODS'
      
        '  (GOODSID, PARENTID, FLG_FOLDER, BASE_PARAM, BASE_PARAM_RU, COD' +
        'E, CODE_RU, TITLE, DETAILS, FLG_SOCIAL, FLG_OLD, FLG_REQUIRE_CER' +
        'TIFICAT, FLG_BEST_PRICE, FLG_PRICE_NBM, FLG_SUPPLIER_PROMO, FLG_' +
        'WEB_HIDE_COMPLECT_ITEMS, WARRANTY, GOODS_ACNT_ID, GOODS_TYPE_ID,' +
        ' GOODS_TYPE_NAME, WEBGOODSTYPE_ID, WEBGOODSTYPE_TITLE, WEBGOODST' +
        'YPE_TITLE_RU, VENDOR_ID, USERID, UMID, SERIAL_TYPE_ID, ORDERNO, ' +
        'USER_FULLNAME, CREATE_DATE, NAMEACNT, PRICE1, PRICE2, PRICE3, PR' +
        'ICE4, PRICE5, PRICE6, PRICE7, PRICE1_LEI, PRICE2_LEI, PRICE3_LEI' +
        ', PRICE4_LEI, PRICE5_LEI, PRICE6_LEI, PRICE7_LEI, PRICEC1_LEI, P' +
        'RICEC2_LEI, PRICEC3_LEI, PRICEC4_LEI, PRICEC5_LEI, PRICEC6_LEI, ' +
        'PRICEC7_LEI, PRICE1_USD, PRICE2_USD, PRICE3_USD, PRICE4_USD, PRI' +
        'CE5_USD, PRICE6_USD, PRICE7_USD, CURRENCYID, CURRENCY_TITLE, VEN' +
        'DOR, UM_TITLE, QTY_ACCOUNT, MINQTY, DELIVERY_TYPEID, DELIVERY_TY' +
        'PENAME, VAT, CASHBACK_PERCENT, COLORID, COLOR_NAME_RO, COLOR_NAM' +
        'E_RU, TEMPLATEID)'
      'VALUES'
      
        '  (:GOODSID, :PARENTID, :FLG_FOLDER, :BASE_PARAM, :BASE_PARAM_RU' +
        ', :CODE, :CODE_RU, :TITLE, :DETAILS, :FLG_SOCIAL, :FLG_OLD, :FLG' +
        '_REQUIRE_CERTIFICAT, :FLG_BEST_PRICE, :FLG_PRICE_NBM, :FLG_SUPPL' +
        'IER_PROMO, :FLG_WEB_HIDE_COMPLECT_ITEMS, :WARRANTY, :GOODS_ACNT_' +
        'ID, :GOODS_TYPE_ID, :GOODS_TYPE_NAME, :WEBGOODSTYPE_ID, :WEBGOOD' +
        'STYPE_TITLE, :WEBGOODSTYPE_TITLE_RU, :VENDOR_ID, :USERID, :UMID,' +
        ' :SERIAL_TYPE_ID, :ORDERNO, :USER_FULLNAME, :CREATE_DATE, :NAMEA' +
        'CNT, :PRICE1, :PRICE2, :PRICE3, :PRICE4, :PRICE5, :PRICE6, :PRIC' +
        'E7, :PRICE1_LEI, :PRICE2_LEI, :PRICE3_LEI, :PRICE4_LEI, :PRICE5_' +
        'LEI, :PRICE6_LEI, :PRICE7_LEI, :PRICEC1_LEI, :PRICEC2_LEI, :PRIC' +
        'EC3_LEI, :PRICEC4_LEI, :PRICEC5_LEI, :PRICEC6_LEI, :PRICEC7_LEI,' +
        ' :PRICE1_USD, :PRICE2_USD, :PRICE3_USD, :PRICE4_USD, :PRICE5_USD' +
        ', :PRICE6_USD, :PRICE7_USD, :CURRENCYID, :CURRENCY_TITLE, :VENDO' +
        'R, :UM_TITLE, :QTY_ACCOUNT, :MINQTY, :DELIVERY_TYPEID, :DELIVERY' +
        '_TYPENAME, :VAT, :CASHBACK_PERCENT, :COLORID, :COLOR_NAME_RO, :C' +
        'OLOR_NAME_RU, :TEMPLATEID)')
    SQLDelete.Strings = (
      'DELETE FROM VW_TS_GOODS'
      'WHERE'
      '  GOODSID = :Old_GOODSID')
    SQLUpdate.Strings = (
      'UPDATE VW_TS_GOODS'
      'SET'
      
        '  GOODSID = :GOODSID, PARENTID = :PARENTID, FLG_FOLDER = :FLG_FO' +
        'LDER, BASE_PARAM = :BASE_PARAM, BASE_PARAM_RU = :BASE_PARAM_RU, ' +
        'CODE = :CODE, CODE_RU = :CODE_RU, TITLE = :TITLE, DETAILS = :DET' +
        'AILS, FLG_SOCIAL = :FLG_SOCIAL, FLG_OLD = :FLG_OLD, FLG_REQUIRE_' +
        'CERTIFICAT = :FLG_REQUIRE_CERTIFICAT, FLG_BEST_PRICE = :FLG_BEST' +
        '_PRICE, FLG_PRICE_NBM = :FLG_PRICE_NBM, FLG_SUPPLIER_PROMO = :FL' +
        'G_SUPPLIER_PROMO, FLG_WEB_HIDE_COMPLECT_ITEMS = :FLG_WEB_HIDE_CO' +
        'MPLECT_ITEMS, WARRANTY = :WARRANTY, GOODS_ACNT_ID = :GOODS_ACNT_' +
        'ID, GOODS_TYPE_ID = :GOODS_TYPE_ID, GOODS_TYPE_NAME = :GOODS_TYP' +
        'E_NAME, WEBGOODSTYPE_ID = :WEBGOODSTYPE_ID, WEBGOODSTYPE_TITLE =' +
        ' :WEBGOODSTYPE_TITLE, WEBGOODSTYPE_TITLE_RU = :WEBGOODSTYPE_TITL' +
        'E_RU, VENDOR_ID = :VENDOR_ID, USERID = :USERID, UMID = :UMID, SE' +
        'RIAL_TYPE_ID = :SERIAL_TYPE_ID, ORDERNO = :ORDERNO, USER_FULLNAM' +
        'E = :USER_FULLNAME, CREATE_DATE = :CREATE_DATE, NAMEACNT = :NAME' +
        'ACNT, PRICE1 = :PRICE1, PRICE2 = :PRICE2, PRICE3 = :PRICE3, PRIC' +
        'E4 = :PRICE4, PRICE5 = :PRICE5, PRICE6 = :PRICE6, PRICE7 = :PRIC' +
        'E7, PRICE1_LEI = :PRICE1_LEI, PRICE2_LEI = :PRICE2_LEI, PRICE3_L' +
        'EI = :PRICE3_LEI, PRICE4_LEI = :PRICE4_LEI, PRICE5_LEI = :PRICE5' +
        '_LEI, PRICE6_LEI = :PRICE6_LEI, PRICE7_LEI = :PRICE7_LEI, PRICEC' +
        '1_LEI = :PRICEC1_LEI, PRICEC2_LEI = :PRICEC2_LEI, PRICEC3_LEI = ' +
        ':PRICEC3_LEI, PRICEC4_LEI = :PRICEC4_LEI, PRICEC5_LEI = :PRICEC5' +
        '_LEI, PRICEC6_LEI = :PRICEC6_LEI, PRICEC7_LEI = :PRICEC7_LEI, PR' +
        'ICE1_USD = :PRICE1_USD, PRICE2_USD = :PRICE2_USD, PRICE3_USD = :' +
        'PRICE3_USD, PRICE4_USD = :PRICE4_USD, PRICE5_USD = :PRICE5_USD, ' +
        'PRICE6_USD = :PRICE6_USD, PRICE7_USD = :PRICE7_USD, CURRENCYID =' +
        ' :CURRENCYID, CURRENCY_TITLE = :CURRENCY_TITLE, VENDOR = :VENDOR' +
        ', UM_TITLE = :UM_TITLE, QTY_ACCOUNT = :QTY_ACCOUNT, MINQTY = :MI' +
        'NQTY, DELIVERY_TYPEID = :DELIVERY_TYPEID, DELIVERY_TYPENAME = :D' +
        'ELIVERY_TYPENAME, VAT = :VAT, CASHBACK_PERCENT = :CASHBACK_PERCE' +
        'NT, COLORID = :COLORID, COLOR_NAME_RO = :COLOR_NAME_RO, COLOR_NA' +
        'ME_RU = :COLOR_NAME_RU, TEMPLATEID = :TEMPLATEID'
      'WHERE'
      '  GOODSID = :Old_GOODSID')
    SQLRefresh.Strings = (
      
        'SELECT GOODSID, PARENTID, FLG_FOLDER, BASE_PARAM, BASE_PARAM_RU,' +
        ' CODE, CODE_RU, TITLE, DETAILS, FLG_SOCIAL, FLG_OLD, FLG_REQUIRE' +
        '_CERTIFICAT, FLG_BEST_PRICE, FLG_PRICE_NBM, FLG_SUPPLIER_PROMO, ' +
        'FLG_WEB_HIDE_COMPLECT_ITEMS, WARRANTY, GOODS_ACNT_ID, GOODS_TYPE' +
        '_ID, GOODS_TYPE_NAME, WEBGOODSTYPE_ID, WEBGOODSTYPE_TITLE, WEBGO' +
        'ODSTYPE_TITLE_RU, VENDOR_ID, USERID, UMID, SERIAL_TYPE_ID, ORDER' +
        'NO, USER_FULLNAME, CREATE_DATE, NAMEACNT, PRICE1, PRICE2, PRICE3' +
        ', PRICE4, PRICE5, PRICE6, PRICE7, PRICE1_LEI, PRICE2_LEI, PRICE3' +
        '_LEI, PRICE4_LEI, PRICE5_LEI, PRICE6_LEI, PRICE7_LEI, PRICEC1_LE' +
        'I, PRICEC2_LEI, PRICEC3_LEI, PRICEC4_LEI, PRICEC5_LEI, PRICEC6_L' +
        'EI, PRICEC7_LEI, PRICE1_USD, PRICE2_USD, PRICE3_USD, PRICE4_USD,' +
        ' PRICE5_USD, PRICE6_USD, PRICE7_USD, CURRENCYID, CURRENCY_TITLE,' +
        ' VENDOR, UM_TITLE, QTY_ACCOUNT, MINQTY, DELIVERY_TYPEID, DELIVER' +
        'Y_TYPENAME, VAT, CASHBACK_PERCENT, COLORID, COLOR_NAME_RO, COLOR' +
        '_NAME_RU, TEMPLATEID FROM VW_TS_GOODS'
      'WHERE'
      '  GOODSID = :GOODSID')
    SQLLock.Strings = (
      'SELECT NULL FROM TS_GOODS'
      'WHERE'
      'GOODSID = :Old_GOODSID'
      'FOR UPDATE WITH LOCK')
    SQLRecCount.Strings = (
      'SELECT COUNT(*) FROM ('
      'SELECT 1 AS C  FROM VW_TS_GOODS'
      ''
      ') q')
    SQL.Strings = (
      'SELECT first 150 g.*, z.cnt, s.title serial_type_name'
      'FROM VW_TS_GOODS G '
      
        'JOIN(SELECT GOODSID, CNT FROM WEB_SEARCH_GOODS_DICTIONARY_v1(:SE' +
        'ARCHTEXT, false, :goodstypeid, 0)) Z '
      '  ON Z.GOODSID = G.GOODSID  '
      'join ts_syss s on s.syssid = g.serial_type_id'
      'order by z.cnt desc')
    RefreshOptions = [roAfterUpdate]
    Left = 848
    Top = 232
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'SEARCHTEXT'
        Value = nil
      end
      item
        DataType = ftUnknown
        Name = 'goodstypeid'
        Value = nil
      end>
  end
