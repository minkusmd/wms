  object IBCQueryTransportator: TIBCQuery
    Transaction = dmDB.IBCTrDefaultSelect
    SQL.Strings = (
      'select C.CUSTOMERID, C.NAME'
      'from TS_CUSTOMER C'
      'join SP_SPLIT((select VALUE_STR'
      '               from TS_SYSS'
      
        '               where SYSSID = 910)) Z on (Z.ID = C.CUSTOMERID) o' +
        'r (C.CUSTOMERID in (:DT, :CT))')
    Left = 352
    Top = 304
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'DT'
        Value = nil
      end
      item
        DataType = ftUnknown
        Name = 'CT'
        Value = nil
      end>
  end
