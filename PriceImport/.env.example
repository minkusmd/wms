# Copiaza in .env (necomis). Parola NU se pune aici: in Docker vine din secrets/fb_password.txt,
# local din variabila de mediu PI_FB_PASSWORD.
PI_FB_HOST=192.168.106.254
PI_FB_PORT=3050
PI_FB_DATABASE=SW
PI_FB_USER=PRICEIMPORT
# Windows, daca fbclient.dll nu e in PATH:
# PI_FB_CLIENT_LIBRARY=C:/Program Files/Firebird/Firebird_5_0/fbclient.dll

PI_TIMEZONE=Europe/Chisinau
# ferestrele (JSON): ora de start; termenele soft/hard in minute de la start
PI_WINDOWS=["09:00", "15:00"]
PI_SOFT_DEADLINE_MIN=40
PI_HARD_DEADLINE_MIN=55
PI_MAX_PARALLEL=4

# canalul raportului (TELEGRAM_CHANNELS); ERRORS primeste doar erorile critice ("" = deloc)
PI_TELEGRAM_CHANNEL=PRICELIST_IMPORT
PI_TELEGRAM_ERRORS_CHANNEL=ERRORS
